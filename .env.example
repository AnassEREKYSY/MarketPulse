# MarketPulse settings. Copy to .env for local runs; never commit the real file.
# Adzuna API credentials: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: stay under your Adzuna plan (free tier is about 25 calls a minute and 250 a day).
ADZUNA_DAILY_LIMIT=240
ADZUNA_PER_MINUTE_LIMIT=24
# Where cached answers are stored (kept across restarts).
CACHE_DIR=/data/cache
# Optional: the Ask page (assistant). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Questions per visitor per day, and for the whole site per day.
ASSISTANT_PER_VISITOR=10
ASSISTANT_DAILY_LIMIT=100
